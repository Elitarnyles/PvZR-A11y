<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PvZRA11y</AssemblyName>
    <RootNamespace>PvZRA11y</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>1.1.0</Version>
    <!-- Interop assemblies are full of fields we never assign; that is normal here. -->
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414</NoWarn>
  </PropertyGroup>

  <!--
    Without this, a wrong GameDir produces several hundred CS0246 errors about types nobody
    has heard of, and the actual problem - one path - is nowhere in the output.
  -->
  <Target Name="CheckGameDir" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(GameDir)MelonLoader\Il2CppAssemblies')"
           Text="No interop assemblies at $(GameDir)MelonLoader\Il2CppAssemblies. Set the game path: dotnet build -p:GameDir=&quot;D:\Your\Path\To\PVZ Replanted\&quot; (the trailing backslash is required). If the folder is missing entirely, run the game once with MelonLoader installed - it generates them on first launch." />
  </Target>

  <!--
    Reference every interop assembly rather than listing them one by one. The folder
    contains only Il2Cpp*/Unity*/Assembly-CSharp, so there is nothing here that can
    collide with the BCL.
  -->
  <ItemGroup>
    <Reference Include="$(GameDir)MelonLoader\Il2CppAssemblies\*.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameDir)MelonLoader\net6\MelonLoader.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameDir)MelonLoader\net6\0Harmony.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameDir)MelonLoader\net6\Il2CppInterop.Runtime.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameDir)MelonLoader\net6\Il2CppInterop.Common.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    The game holds the mod file open while it runs, so this copy fails if you forget to
    close it. That must be loud: a silently skipped copy means the next test session runs
    the previous build, and every conclusion drawn from it is wrong.
  -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(GameDir)Mods')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)Mods"
          Retries="3" RetryDelayMilliseconds="500" ContinueOnError="true">
      <Output TaskParameter="CopiedFiles" ItemName="_DeployedFiles" />
    </Copy>
    <Error Condition="'@(_DeployedFiles)' == ''"
           Text="Could not copy $(TargetFileName) into $(GameDir)Mods. Close the game and build again - it locks the mod file while running." />
    <Message Importance="high" Text="Deployed $(TargetFileName) -> $(GameDir)Mods" />
  </Target>

</Project>
